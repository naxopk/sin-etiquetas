# En el VPS, setup-vps.sh genera /srv/sin-etiquetas/.env con las claves ya puestas. Esto es solo la referencia.
DATABASE_URL=pglite:./.pglite        # VPS: postgres://se_app:…@127.0.0.1:5432/sinetiquetas · Vercel: la URL de Neon
ADMIN_DATABASE_URL=                  # VPS: usuario dueño de las tablas, solo para npm run db:init
TURNSTILE_SITE_KEY=                  # clave pública de Cloudflare Turnstile
TURNSTILE_SECRET=                    # clave secreta de Cloudflare Turnstile
RATE_SECRET=                         # texto aleatorio largo: openssl rand -hex 32
CRON_SECRET=                         # texto aleatorio largo: openssl rand -hex 32
PUBLISHER_NAME=                      # quién es responsable de la web (aparece en la ficha técnica y la privacidad)
CONTACT_EMAIL=
REPO_URL=                            # https://github.com/tu-usuario/sin-etiquetas
# SHOW_PARTY_RESULTS=false           # para no mostrar nunca resultados por partido
# TRUST_PROXY_HEADER=cf-connecting-ip # solo con Cloudflare delante y el cortafuegos de deploy/ufw-cloudflare.sh
# GITHUB_TOKEN=                      # opcional: más margen para consultar las estrellas
